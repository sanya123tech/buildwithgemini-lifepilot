# LifePilot AI Environment Configuration

# Optional: Google Gemini API Key for LLM-powered tool orchestration.
# If omitted, LifePilot automatically runs in Autonomous Simulation Mode (Mock LLM Engine).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database path (defaults to ./lifepilot.db if empty)
LIFEPILOT_DB_PATH=./lifepilot.db

# Backend server host & port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
